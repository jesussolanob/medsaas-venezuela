{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev", "cwd": "apps/frontend" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "next build", "cwd": "apps/frontend" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "next start", "cwd": "apps/frontend" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint .", "cwd": "apps/frontend" }
    },
    "sql-watch": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/sql-watch.mjs", "cwd": "apps/frontend" }
    },
    "sql-run": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/sql-run.mjs", "cwd": "apps/frontend" }
    },
    "qa-setup": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/create-qa-users.mjs", "cwd": "apps/frontend" }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright test", "cwd": "apps/frontend" }
    },
    "test-e2e-ui": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright test --ui", "cwd": "apps/frontend" }
    },
    "test-e2e-report": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright show-report", "cwd": "apps/frontend" }
    }
  }
}
