NODE_ENV=development
PORT=3001

# Base de datos local (Docker)
DATABASE_URL=postgres://delta:delta_dev_password@localhost:5432/deltamedical

# Redis local (Docker)
REDIS_URL=redis://:redis_dev_password@localhost:6379

# Encriptación — INSTRUCCIONES OBLIGATORIAS:
#
#   1. NUNCA copiar estos valores a staging, producción, ni a cualquier entorno compartido.
#   2. NUNCA usar valores triviales (todo ceros, todo unos, o cualquier patrón repetido).
#   3. Cada desarrollador debe generar sus propias llaves locales con:
#        openssl rand -hex 32   # para ENCRYPTION_KEY
#        openssl rand -hex 32   # para ENCRYPTION_HMAC_SECRET
#   4. En producción y staging, las llaves vienen de Secret Manager (migracion/04-gcp-infra.md).
#      CryptoService lanza al boot si detecta llaves triviales fuera de development.
#
# 64 hex chars = 32 bytes. AES-256-GCM para cifrado, HMAC-SHA256 para búsqueda.
ENCRYPTION_KEY=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
ENCRYPTION_HMAC_SECRET=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32

# CORS — acepta requests desde el frontend de desarrollo
CORS_ORIGIN=http://localhost:3000

# Storage — selecciona el adapter activo: 'minio' (dev) | 'gcs' (prod)
STORAGE_DRIVER=minio

# MinIO (desarrollo local — Docker)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=delta
MINIO_SECRET_KEY=delta-secret-dev
MINIO_BUCKET=delta-uploads
MINIO_PUBLIC_URL=http://localhost:9000/delta-uploads

# Google Cloud Storage (producción — NO usar en desarrollo)
GCS_PROJECT_ID=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
