{
  "name": "shared-crypto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-crypto/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/shared-crypto/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/shared-crypto"],
      "options": {
        "jestConfig": "libs/shared-crypto/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
